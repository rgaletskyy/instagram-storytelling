# Copy to .env and paste your keys. .env is gitignored and never leaves this machine.
# Real environment variables take precedence over anything set here.

ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Optional: which model reads your photos and video frames. Defaults to
# claude-sonnet-5. An id starting with "deepseek" is sent to DeepSeek instead
# and needs DEEPSEEK_API_KEY; only this step moves, the rest stays on Claude.
# DESCRIBE_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_API_KEY=sk-...

# Only for --index-images over video: the screenshots it samples are uploaded to
# Drive, beside the clip they came from, which needs write access the public
# links do not carry. Set the OAuth app's audience to Internal and give it the
# full `drive` scope -- drive.file only reaches files the app itself created,
# and the folder goes next to a video it did not. Then `uv run authorize-drive`
# prints the refresh token. See "Cataloguing the image library" in README.md.
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# GOOGLE_OAUTH_REFRESH_TOKEN=1//...

# Optional: point at specific ffmpeg binaries. Only needed for video input --
# slides render in a headless browser, not through ffmpeg.
# STORY_FFMPEG=.tools/ffmpeg
# STORY_FFPROBE=.tools/ffprobe

# Product search (RAG): `uv run rag-index` and SearchService. GEMINI_API_KEY above
# does the embeddings; Firestore uses Application Default Credentials
# (`gcloud auth application-default login`). See "Product search" in README.md.
# GOOGLE_CLOUD_PROJECT=your-project-id
# TYPESAFE_API_KEY=...

# Search API (`uvicorn api.app:create_app --factory`). It will not start without
# both. See "Search API" in README.md.
# USER_TOKEN_AUDIENCE=<portal Google OAuth client id>.apps.googleusercontent.com
# ALLOWED_USERS=anna@example.com,petro@example.com
