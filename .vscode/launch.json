{
  "version": "0.2.0",
  "configurations": [
    {
      // The search API on http://localhost:8080, as `uvicorn api.app:create_app
      // --factory` runs it. No --reload: the reloader serves requests from a
      // child process, where breakpoints are never hit.
      "name": "Debug API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.app:create_app", "--factory", "--port", "8080"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      // create_app reads .env itself; loading it here as well puts the values
      // in place before any module is imported.
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONUNBUFFERED": "1" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "API: debug unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/unit/test_api.py", "-q"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
