# Copy to .env.local for `npm run dev`. On Cloud Run the two secrets come from
# Secret Manager and the rest are plain environment variables.

# The portal's own URL. Sign-in redirects back here.
NEXTAUTH_URL=http://localhost:3000
# Encrypts the session cookie. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The Google OAuth client users sign in with (Web application). Its client id
# is also the API's USER_TOKEN_AUDIENCE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail addresses allowed to sign in, comma-separated. Empty means nobody.
ALLOWED_USERS=

# The search API. Locally: uv run uvicorn api.app:create_app --factory --port 8080
API_URL=http://localhost:8080
# On Cloud Run, the API's URL again: the audience of the service token Cloud
# Run checks. Leave unset locally, where no Cloud Run sits in front of the API.
API_AUDIENCE=
